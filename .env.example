# ==========================================================================
#  HIGHH — production .env
# ==========================================================================

# ---- core ----
APP_ENV=production                 # development | production (production fails fast if insecure)
DATABASE_URL=postgresql+psycopg2://highh:changeme@db:5432/highh   # change the password before deploy

# ---- security (required in production) ----
AUTH_ENABLED=1
API_KEYS=hh_replace_me             # replace with a strong key, or use API_KEY_HASHES below
# API_KEY_HASHES=<sha256>,<sha256>
RBAC_ENABLED=1
CORS_ORIGINS=https://app.example.com     # explicit allowlist; never * in production
TRUSTED_HOSTS=app.example.com
RATE_LIMIT_PER_MIN=120
MAX_BODY_BYTES=1048576

# ---- calling window guardrail ----
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=20             # 8pm — keep <=21 for DND/TRAI compliance; do NOT use 24 in prod

# ---- providers (drop-in; leave blank to use local engines) ----
ANTHROPIC_API_KEY=                 # leave blank — agent brain runs via BYO below
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=sk_3c600bcab63e41b65e6ee19b1b53a0194599b27c0e80b513
WHATSAPP_PROVIDER=local
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ---- ops ----
WEB_CONCURRENCY=3
LOG_JSON=1
LOG_LEVEL=INFO

# ---- human voice tuning ----
VOICE_PROFILE=warm_consultative        # warm_consultative | brisk_closer | calm_support
TTS_VOICE_ID=                          # ElevenLabs voice id (pick a friendly human voice)
# VOICE_OVERRIDES={"comma_pause_ms":120,"eleven":{"style":0.5}}

# ---- omnichannel + dialer ----
SMS_PROVIDER=local          # local | twilio
SMS_FROM=
EMAIL_PROVIDER=local        # local | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=admissions@empowersacademy.com
BROCHURE_URL=https://example.com/brochure.pdf
DIALER_MAX_CONCURRENT=5
DIALER_CALLS_PER_MIN=20
DIALER_TIMEZONE=Asia/Kolkata

# ---- RAG / analytics / calendar ----
RAG_TOP_K=4
COST_TWILIO_PER_MIN=0.014
COST_STT_PER_MIN=0.0043
COST_TTS_PER_MIN=0.03
COST_LLM_PER_CALL=0.01
CALENDAR_PROVIDER=local     # local | google | outlook
CALENDAR_TOKEN=
CALENDAR_ID=primary

# ---- payments / embeddings / monitoring ----
PAYMENT_PROVIDER=local        # local | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYMENT_AMOUNT_INR=50000
EMBEDDINGS_PROVIDER=local     # local | openai | voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
ALERT_WEBHOOK_URL=
ALERT_LATENCY_MS=1500
ALERT_COST_PER_CALL_USD=0.5

# ---- Exotel telephony (India) ----
TELEPHONY_PROVIDER=exotel
EXOTEL_SID=empowersacademy1
EXOTEL_API_KEY=1bbc7fc1825afcdef31447414ab42918ce12005d4f0b52c3
EXOTEL_API_TOKEN=c8e6d4e075856634e148a2d8a82c3f6a1f962ad836138f54
EXOTEL_CALLER_ID=080-473-62355     # must be your verified ExoPhone; confirm exact format in Exotel
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_REGION=in
EXOTEL_FLOW_APP_ID=                # App Bazaar voicebot flow id (streaming); blank = ExoML turn-by-turn
# Register in the Exotel flow (public HTTPS):
#   answer      : {BASE}/v1/telephony/exotel/answer
#   status      : {BASE}/v1/telephony/exotel/status
#   voicebot WS : {BASE}/v1/telephony/exotel/voicebot/{call_id}

# ---- BYO LLM (agent brain) ----
LLM_PROVIDER=byo               # local | anthropic | byo
BYO_PROTOCOL=auto              # auto | gemini | openai | anthropic
BYO_BASE_URL=https://generativelanguage.googleapis.com/v1beta   # Gemini; change if OpenAI/Anthropic
BYO_API_KEY=
BYO_MODEL=gemini-1.5-flash     # or gpt-4o-mini | claude-sonnet-4-6