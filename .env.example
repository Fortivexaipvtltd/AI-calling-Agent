# ---- core ----
APP_ENV=production                 # development | production (production fails fast if insecure)
DATABASE_URL=postgresql+psycopg2://highh:changeme@db:5432/highh

# ---- security (required in production) ----
AUTH_ENABLED=1
# Comma-separated raw keys (dev) OR pre-hashed sha256 keys (prod, preferred):
API_KEYS=hh_replace_me
# API_KEY_HASHES=<sha256>,<sha256>
RBAC_ENABLED=1
CORS_ORIGINS=https://app.example.com     # explicit allowlist; never * in production
TRUSTED_HOSTS=app.example.com
RATE_LIMIT_PER_MIN=120
MAX_BODY_BYTES=1048576

# ---- calling window guardrail ----
CALL_WINDOW_START_HOUR=9
CALL_WINDOW_END_HOUR=20

# ---- providers (drop-in; leave blank to use local engines) ----
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_PROVIDER=local
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
BYO_BASE_URL=
BYO_API_KEY=
BYO_MODEL=

# ---- ops ----
WEB_CONCURRENCY=3
LOG_JSON=1
LOG_LEVEL=INFO

# ---- human voice tuning ----
VOICE_PROFILE=warm_consultative        # warm_consultative | brisk_closer | calm_support
TTS_VOICE_ID=                          # ElevenLabs voice id (pick a friendly human voice)
# VOICE_OVERRIDES={"comma_pause_ms":120,"eleven":{"style":0.5}}
